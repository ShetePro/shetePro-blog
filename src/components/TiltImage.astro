---
import {Image} from "astro:assets";
interface Props {
  image: any;
  name: string
}

const { image, name } = Astro.props;
---
<style>
  .container {
    width: 100%;
    height: 100%;
    perspective: 1000px; /* 设置透视效果 */
  }

  .tilt-image {
    width: 100%;
    height: 100%;
    transition: transform 0.1s;
    transform-style: preserve-3d;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.2);
    border-radius: 10px;
    user-select: none;
    -webkit-user-drag: none;
  }
  @median (max-width: 640px) {
    .tilt-image {
      width: 100px !important;
      height: 100px !important;
    }
  }
</style>
<div class="container">
  <Image
    class="tilt-image"
    width={10}
    height={10}
    src={image}
    alt={name}
    decoding="async"
    loading="lazy"
  />
</div>
<script>
  document.addEventListener('astro:page-load', () => {
    onPageLoad();
  });
  function onPageLoad () {
    const image = document.querySelector('.tilt-image');
    const container = document.querySelector('.container');
    if(image && container) {
      container.addEventListener('mousemove', (e: any) => {
        const { left, top, width, height } = container.getBoundingClientRect();
        const x = e.clientX - left;
        const y = e.clientY - top;
        const centerX = width / 2;
        const centerY = height / 2;
        const rotateX = ((y - centerY) / centerY) * 20; // 调整旋转角度
        const rotateY = ((x - centerX) / centerX) * -20; // 调整旋转角度
        image.style.transform = `rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
      });
      container.addEventListener('mouseleave', () => {
        image.style.transform = 'rotateX(0) rotateY(0)';
      });
    }
  }

</script>
